---
import { createHash } from 'node:crypto';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/motion.css';
import '../styles/base.css';
import { type Lang, type Dict, homePath } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const site = 'https://vertostudio.ru';
const url = site + homePath(lang);
const ogImage = `${site}/og/og-${lang}.jpg`;

// Ранний скрипт: классы js / preload / motion-off до первой отрисовки.
// Inline ради скорости; разрешён в CSP по sha256-хэшу, посчитанному здесь же.
const boot = `(function(d){var h=d.documentElement;h.classList.add('js');try{var r=matchMedia('(prefers-reduced-motion: reduce)').matches;var s=localStorage.getItem('verto-motion');if(s==='off'||(r&&s!=='on')){h.classList.add('motion-off')}else if(!sessionStorage.getItem('verto-fueled')){h.classList.add('preload')}}catch(e){}})(document);`;
const bootHash = createHash('sha256').update(boot).digest('base64');

const csp = [
  "default-src 'self'",
  // в dev Astro вставляет свои inline-скрипты (HMR, панель) — разрешаем их только локально
  import.meta.env.DEV ? "script-src 'self' 'unsafe-inline'" : `script-src 'self' 'sha256-${bootHash}'`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "font-src 'self'",
  "connect-src 'self'",
  "media-src 'self'",
  "worker-src 'self' blob:",
  "frame-src 'none'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Verto Studio',
  url: site + '/',
  logo: `${site}/favicon.svg`,
  description: t.meta.description,
  sameAs: [t.contacts.telegram, t.contacts.channel, t.contacts.instagram],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    telephone: '+79935358696',
    url: t.contacts.telegram,
    availableLanguage: ['ru', 'en'],
  },
};
const preloadText = lang === 'ru' ? 'golos-text-cyrillic-400-normal' : 'golos-text-latin-400-normal';
---
<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline set:html={boot}></script>
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#05070D" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="ru" href={site + '/'} />
    <link rel="alternate" hreflang="en" href={site + '/en/'} />
    <link rel="alternate" hreflang="x-default" href={site + '/'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/rocket/poster-hero.webp" as="image" type="image/webp" fetchpriority="high" />
    <link rel="preload" href="/fonts/unbounded-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`/fonts/${preloadText}.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Verto Studio" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
