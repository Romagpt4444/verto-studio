---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Altimeter from './Altimeter.astro';
import Preloader from './Preloader.astro';
import Hero from './Hero.astro';
import Manifest from './Manifest.astro';
import Marquee from './Marquee.astro';
import Stack from './Stack.astro';
import Collection from './Collection.astro';
import Launch from './Launch.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import '../styles/sections.css';
import { type Lang, getDict } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---
<Base lang={lang} t={t}>
  <a class="skip-link" href="#content">{t.nav.skip}</a>
  <Preloader t={t} />
  <div class="space" aria-hidden="true">
    <div class="space-stars"></div>
    <div class="space-planet" data-planet></div>
  </div>
  <div class="rocket-layer" aria-hidden="true" data-rocket-layer></div>
  <Header lang={lang} t={t} />
  <Altimeter t={t} />
  <main id="content" tabindex="-1">
    <Hero t={t} />
    <Manifest t={t} />
    <Marquee t={t} />
    <Stack t={t} />
    <Collection t={t} />
    <Launch t={t} />
    <Faq t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
  <script>
    import '../scripts/main.ts';
  </script>
</Base>
