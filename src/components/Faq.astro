---
import Icon from './Icon.astro';
import type { Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section id="faq" class="section faq" aria-labelledby="faq-title" data-section>
  <div class="shell faq-grid">
    <h2 id="faq-title" class="section-title" data-split>{t.faq.title}</h2>
    <div class="faq-list">
      {t.faq.items.map((f) => (
        <details class="faq-item">
          <summary>
            <span class="faq-q">{f.q}</span>
            <span class="faq-icon" aria-hidden="true"><Icon name="plus" /></span>
          </summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
