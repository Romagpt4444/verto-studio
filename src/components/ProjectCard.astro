---
import Sticker from './Sticker.astro';
import type { Dict } from '../i18n';
type Item = Dict['works']['items'][number];
interface Props { item: Item; index: number; t: Dict }
const { item, index, t } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const typeLabel = t.works.types[item.type as keyof typeof t.works.types];
---
<li class="card" data-card data-kind={item.type}>
  <article class="card-inner" aria-labelledby={`work-${item.id}`}>
    <div class="card-media">
      <img
        src={`/works/${item.id}-640.webp`}
        srcset={`/works/${item.id}-640.webp 640w, /works/${item.id}-1280.webp 1280w`}
        sizes="(min-width: 1024px) 34vw, (min-width: 640px) 60vw, 92vw"
        width="640"
        height="400"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <span class="card-num" aria-hidden="true">{num}</span>
      <Sticker emoji={item.sticker} size={88} class="card-sticker" />
    </div>
    <div class="card-body">
      <p class="card-type mono">{typeLabel}</p>
      <h3 class="card-title" id={`work-${item.id}`}>{item.title}</h3>
      <p class="card-text">{item.text}</p>
      <ul role="list" class="card-tags">
        {item.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <div class="card-actions">
        <a class="btn btn-ghost btn-sm" href={item.link}>
          <span>{t.works.open}</span>
          {item.linkNote && <span class="card-note">{item.linkNote}</span>}
          <span class="sr-only">: {item.title}</span>
        </a>
        {item.site && (
          <a class="link-line card-site" href={item.site} target="_blank" rel="noopener noreferrer">
            {t.works.site}<span class="sr-only"> {item.title} ({t.ui.newTab})</span>
          </a>
        )}
      </div>
    </div>
  </article>
</li>
