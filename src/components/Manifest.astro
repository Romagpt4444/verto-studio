---
import Sticker from './Sticker.astro';
import type { Dict } from '../i18n';
interface Props { t: Dict }
const { t } = Astro.props;
---
<section id="create" class="section create" aria-labelledby="create-title" data-section>
  <div class="shell create-grid">
    <article class="passport" data-passport>
      <header class="passport-head">
        <h2 id="create-title" class="passport-title">{t.create.title}</h2>
        <div class="passport-rule" aria-hidden="true"></div>
        <p class="passport-label mono">{t.create.label}</p>
      </header>
      <ul role="list" class="passport-rows">
        {t.create.rows.map((r) => (
          <li class="passport-row" data-passport-row>
            <div>
              <h3 class="passport-name">{r.name}</h3>
              <p class="passport-text">{r.text}</p>
            </div>
            <span class="passport-value mono" data-count={parseInt(r.value, 10)} data-suffix="%">{r.value}</span>
          </li>
        ))}
      </ul>
      <p class="passport-foot mono">
        <span>{t.create.footnote}</span>
        <Sticker cp="1f525" size={24} />
      </p>
    </article>
  </div>
</section>
